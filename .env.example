# ==============================================================================
# FORMA Studio — Environment Configuration Template
# ==============================================================================
# The website runs as a zero-config, static HTML export by default.
# All parameters in src/config/site.ts have sensible production defaults.
# Copy this file to .env.local to override settings for custom deployments.

# ------------------------------------------------------------------------------
# 1. Base URL & Canonical Domain
# ------------------------------------------------------------------------------
# Used for OpenGraph, Twitter Cards, Sitemap, and canonical links.
NEXT_PUBLIC_SITE_URL=https://studioforma.design

# ------------------------------------------------------------------------------
# 2. Studio Contact Overrides (Optional)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_STUDIO_EMAIL=hello@studioforma.design
NEXT_PUBLIC_STUDIO_PHONE=+919820038476
NEXT_PUBLIC_WHATSAPP_URL=https://wa.me/919820038476

# ------------------------------------------------------------------------------
# 3. Analytics & Telemetry (Optional)
# ------------------------------------------------------------------------------
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# ------------------------------------------------------------------------------
# 4. Form Handling Service (Optional)
# ------------------------------------------------------------------------------
# By default, the contact page validates briefs client-side and formats them
# for one-click clipboard copying or native email dispatch.
# If integrating with an external service (e.g., Formspree, Resend, or Web3Forms):
# CONTACT_FORM_ENDPOINT=https://formspree.io/f/your_form_id
# RESEND_API_KEY=re_your_api_key
